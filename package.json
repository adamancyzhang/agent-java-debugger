{
  "name": "@adamancyzhang/agent-java-debugger",
  "version": "0.2.2",
  "description": "JDWP CLI debugger for remote JVMs — breakpoints, stepping, and in-memory inspection for AI agents (pure Python stdlib; requires Python >= 3.10).",
  "bin": {
    "agent-java-debugger": "dist/cli.js"
  },
  "engines": {
    "node": ">=14"
  },
  "files": [
    "dist",
    "skills",
    "skill-data"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamancyzhang/agent-java-debugger.git"
  },
  "license": "MIT",
  "keywords": [
    "java",
    "jvm",
    "jdwp",
    "debugger",
    "breakpoint",
    "cli",
    "agent",
    "graphql"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "check-skill": "node scripts/check-skill.mjs",
    "prepublishOnly": "npm run build",
    "test": "tests/e2e_sample.sh"
  }
}
